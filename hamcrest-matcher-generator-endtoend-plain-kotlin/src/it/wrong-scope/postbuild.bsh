// The build must fail for the scope violation in Check.kt, not for something else. The DslMarker wording is the one
// Kotlin has used for years: the outer scope's function "can't be called in this context by implicit receiver".
// BeanShell, not Groovy: the Groovy the invoker bundles cannot read the class files of the newest JDKs.
String log = new String(java.nio.file.Files.readAllBytes(new File(basedir, "build.log").toPath()), "UTF-8");
if (!(log.contains("Check.kt") && log.contains("implicit receiver"))) {
    throw new RuntimeException("Another failure: " + log);
}
