<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.marmer.testutils</groupId>
        <artifactId>hamcrest-matcher-generator-endtoend</artifactId>
        <version>5.1.0</version>
        <relativePath>../hamcrest-matcher-generator-endtoend/pom.xml</relativePath>
    </parent>

    <artifactId>hamcrest-matcher-generator-endtoend-plain-kotlin</artifactId>

    <properties>
        <!-- -DskipTests=true on the build skips the consumer builds of src/it, like the Surefire tests. -->
        <skipTests>false</skipTests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.marmer.testutils</groupId>
            <artifactId>hamcrest-matcher-generator</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.marmer.testutils</groupId>
            <artifactId>hamcrest-matcher-generator-kotlin</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk8</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <!-- The generated DSL promises Kotlin 1.9 language features only (spec 104). -->
                    <languageVersion>1.9</languageVersion>
                    <apiVersion>1.9</apiVersion>
                </configuration>
                <executions>
                    <!-- tag::test-kapt[] -->
                    <execution>
                        <id>test-kapt</id>
                        <goals>
                            <goal>test-kapt</goal>
                        </goals>
                        <configuration>
                            <correctErrorTypes>true</correctErrorTypes>
                            <sourceDirs>
                                <sourceDir>src/main/kotlin</sourceDir>
                                <sourceDir>src/test/kotlin</sourceDir>
                            </sourceDirs>
                            <annotationProcessorPaths>
                                <annotationProcessorPath>
                                    <groupId>io.github.marmer.testutils</groupId>
                                    <artifactId>hamcrest-matcher-generator</artifactId>
                                    <version>${project.version}</version>
                                </annotationProcessorPath>
                                <annotationProcessorPath>
                                    <groupId>io.github.marmer.testutils</groupId>
                                    <artifactId>hamcrest-matcher-generator-kotlin</artifactId>
                                    <version>${project.version}</version>
                                </annotationProcessorPath>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <!-- end::test-kapt[] -->
                    <execution>
                        <id>compile</id>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                        <configuration>
                            <!-- tag::test-compile-source-dirs[] -->
                            <sourceDirs>
                                <sourceDir>${project.basedir}/src/test/kotlin</sourceDir>
                                <sourceDir>${project.build.directory}/generated-sources/kapt/test</sourceDir>
                                <sourceDir>${project.build.directory}/generated-sources/kaptKotlin/test</sourceDir>
                            </sourceDirs>
                            <!-- end::test-compile-source-dirs[] -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- javac compiles only the KAPT matchers that Java sources reference, unless the output is a test source root. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <!-- tag::add-kapt-test-source[] -->
                    <execution>
                        <id>add-kapt-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/kapt/test</source>
                            </sources>
                        </configuration>
                    </execution>
                    <!-- end::add-kapt-test-source[] -->
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <!--
                    The compile-failure checks of src/it: each project is a consumer build of the DSL that the Kotlin
                    compiler must reject (or accept, as the control). The build runs the kotlin-maven-plugin, so the Kotlin
                    compiler stays in the plugin class path and out of this module's test dependencies. install copies the
                    test-scope reactor artifacts into target/local-repo, so the consumers resolve them there. Consumers must
                    work on a fresh local repository, as on CI, which runs a plain verify without a prior install. An
                    earlier copy in target/local-repo is not replaced, so run with clean.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <configuration>
                    <projectsDirectory>${project.basedir}/src/it</projectsDirectory>
                    <pomIncludes>
                        <pomInclude>*/pom.xml</pomInclude>
                    </pomIncludes>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
                    <settingsFile>${project.basedir}/src/it/settings.xml</settingsFile>
                    <!-- The consumer builds are this module's compile-failure tests: -DskipTests skips them, as it skips the
                        Surefire tests, and install does not copy the artifacts for them. -->
                    <skipInstallation>${skipTests}</skipInstallation>
                    <skipInvocation>${skipTests}</skipInvocation>
                    <streamLogsOnFailures>true</streamLogsOnFailures>
                </configuration>
                <executions>
                    <execution>
                        <id>install-reactor-artifacts</id>
                        <goals>
                            <goal>install</goal>
                        </goals>
                        <configuration>
                            <!-- The consumers depend on hamcrest-matcher-generator and -kotlin in test scope, which the default runtime scope leaves out. -->
                            <scope>test</scope>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-compile-failure-checks</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Not active by default. Run it with -Pintellij-kotlin-tests when the IDE does not see the kapt test sources. -->
        <!-- tag::intellij-antrun[] -->
        <profile>
            <id>intellij-kotlin-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.0.0</version>
                        <executions>
                            <execution>
                                <phase>process-test-sources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <move todir="${project.basedir}/target/generated-test-sources/test-annotations"
                                            force="true">
                                            <fileset dir="${project.basedir}/target/generated-sources/kapt/test/"/>
                                        </move>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- end::intellij-antrun[] -->
    </profiles>
</project>
