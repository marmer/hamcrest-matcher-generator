<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.marmer.testutils</groupId>
        <artifactId>hamcrest-matcher-generator-endtoend</artifactId>
        <version>5.1.0</version>
        <relativePath>../hamcrest-matcher-generator-endtoend/pom.xml</relativePath>
    </parent>

    <artifactId>hamcrest-matcher-generator-endtoend-5x-compatibility-runner</artifactId>
    <version>5.1.0</version>
    <packaging>pom</packaging>
    <name>hamcrest-matcher-generator-endtoend-5x-compatibility-runner</name>
    <description>Runs the frozen 5.x compatibility suite as a consumer build (see docs/agents/5x-compatibility.md). Never published.</description>

    <properties>
        <!-- -DskipTests=true on the outer build compiles the suite without running it; the outer build then did not
            resolve the Surefire provider, which the isolated build may not fetch from the network. -->
        <skipTests>false</skipTests>
    </properties>

    <!-- The runner only orders itself after the bridge modules whose artifacts the suite consumes. invoker:install puts
        these, the Hamcrest backend they depend on and the parent into an isolated local repository, where the suite
        resolves the 5.x coordinates like a 5.x user would, with the project's own compiler plugin version. -->
    <dependencies>
        <dependency>
            <groupId>io.github.marmer.testutils</groupId>
            <artifactId>hamcrest-matcher-generator-annotationprocessor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.marmer.testutils</groupId>
            <artifactId>hamcrest-matcher-generator-dependencies</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The suite resolves the next two from the outer local repository, and nothing orders this module after the
            module that downloads them there: example-maven-kotlin fetches annotations 13.0 in its kapt goal, and in the
            parallel reactor the runner can start before it (cold repository: "Could not find artifact
            org.jetbrains:annotations:jar:13.0 in outer-local-repository"). Resolving them here, as this module's own
            dependencies, puts them there before the invoker goals run. Versions as in the suite's pom. -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>13.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.48</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <configuration>
                    <projectsDirectory>${project.basedir}/../hamcrest-matcher-generator-endtoend-5x-compatibility</projectsDirectory>
                    <pomIncludes>
                        <pomInclude>pom.xml</pomInclude>
                    </pomIncludes>
                    <cloneProjectsTo>${project.build.directory}/it/hamcrest-matcher-generator-endtoend-5x-compatibility</cloneProjectsTo>
                    <localRepositoryPath>${project.build.directory}/local-repo</localRepositoryPath>
                    <!-- The outer local repository serves as the only remote, so the suite resolves nothing from the network. -->
                    <settingsFile>${project.basedir}/src/it/settings.xml</settingsFile>
                    <goals>
                        <goal>verify</goal>
                    </goals>
                    <properties>
                        <skipTests>${skipTests}</skipTests>
                        <!-- The frozen suite inherits the parent, but its build is not checked by the static-analysis profile. -->
                        <skipStaticAnalysis>true</skipStaticAnalysis>
                    </properties>
                    <streamLogsOnFailures>true</streamLogsOnFailures>
                </configuration>
                <executions>
                    <execution>
                        <id>run-5x-compatibility-suite</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
