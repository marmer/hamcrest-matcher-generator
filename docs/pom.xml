<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.marmer.testutils</groupId>
        <artifactId>matcher-generator-parent</artifactId>
        <version>5.1.0</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>hamcrest-matcher-generator-docs</artifactId>
    <name>hamcrest-matcher-generator-docs</name>
    <description>Renders the project documentation (arc42) to HTML and checks the result</description>

    <properties>
        <asciidoctor.maven.plugin.version>3.2.0</asciidoctor.maven.plugin.version>
        <asciidoctorj.version>3.0.0</asciidoctorj.version>
        <jsoup.version>1.23.2</jsoup.version>
        <!-- All Structurizr artifacts are updated together (ADR 0003): the rendering uses their jars as a CLI home. -->
        <structurizr.version>6.2.3</structurizr.version>
        <asciidoctorj.diagram.version>3.2.1</asciidoctorj.diagram.version>
        <asciidoctorj.diagram.plantuml.version>1.2026.2</asciidoctorj.diagram.plantuml.version>
        <maven.dependency.plugin.version>3.8.1</maven.dependency.plugin.version>
        <properties.maven.plugin.version>1.2.1</properties.maven.plugin.version>
        <structurizr.home>${project.build.directory}/structurizr</structurizr.home>
        <maven.build.timestamp.format>yyyy-MM-dd</maven.build.timestamp.format>
        <docs.output.directory>${project.build.directory}/generated-docs</docs.output.directory>
        <!-- the module produces only the rendered site (no jar), so there is nothing to install or deploy -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- Runtime scope: copied into the Structurizr home below and also used by the view test to read the workspace.
            structurizr-client is needed by the exporter at run time; the transitive dependencies come along. -->
        <dependency>
            <groupId>com.structurizr</groupId>
            <artifactId>structurizr-dsl</artifactId>
            <version>${structurizr.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.structurizr</groupId>
            <artifactId>structurizr-export</artifactId>
            <version>${structurizr.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.structurizr</groupId>
            <artifactId>structurizr-import</artifactId>
            <version>${structurizr.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.structurizr</groupId>
            <artifactId>structurizr-client</artifactId>
            <version>${structurizr.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The docs module is built on JDK 21 or later and never reaches a user's classpath, so the Java 21 bytecode
                of Structurizr is fine here (ADR 0003). Everything else must still target Java 17. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-bytecode-17</id>
                        <configuration>
                            <rules>
                                <enforceBytecodeVersion>
                                    <maxJdkVersion>17</maxJdkVersion>
                                    <excludes>
                                        <exclude>com.structurizr:*</exclude>
                                    </excludes>
                                </enforceBytecodeVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Same reasoning: Structurizr's JAXB and activation artifacts (CDDL/GPL) only ever reach this module's tooling. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <configuration>
                    <excludedArtifacts>jaxb-api|javax\.activation-api</excludedArtifacts>
                </configuration>
            </plugin>
            <!-- asciidoctorj-diagram's structurizr block wants the home of a Structurizr CLI. A folder whose lib/ holds
                the jars is enough, so no CLI download and no Docker is needed. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven.dependency.plugin.version}</version>
                <executions>
                    <execution>
                        <id>structurizr-home</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputDirectory>${structurizr.home}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- asciidoctorj-diagram reads the home from this system property of the Maven JVM. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>properties-maven-plugin</artifactId>
                <version>${properties.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>structurizr-cli-home</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>set-system-properties</goal>
                        </goals>
                        <configuration>
                            <properties>
                                <property>
                                    <name>diagram.structurizrcli.home</name>
                                    <value>${structurizr.home}</value>
                                </property>
                            </properties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.asciidoctor</groupId>
                <artifactId>asciidoctor-maven-plugin</artifactId>
                <version>${asciidoctor.maven.plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj</artifactId>
                        <version>${asciidoctorj.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj-diagram</artifactId>
                        <version>${asciidoctorj.diagram.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.asciidoctor</groupId>
                        <artifactId>asciidoctorj-diagram-plantuml</artifactId>
                        <version>${asciidoctorj.diagram.plantuml.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <!-- Before the test phase, so the tests check the rendered HTML. -->
                    <execution>
                        <id>render-docs</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>process-asciidoc</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>src/docs/asciidoc</sourceDirectory>
                            <outputDirectory>${docs.output.directory}</outputDirectory>
                            <backend>html5</backend>
                            <!-- Includes resolve relative to the including document. Directories starting with an
                                underscore (the arc42 chapters) are included by index.adoc but not rendered on their own. -->
                            <relativeBaseDir>true</relativeBaseDir>
                            <preserveDirectories>true</preserveDirectories>
                            <resources>
                                <resource>
                                    <directory>src/docs/asciidoc</directory>
                                    <includes>
                                        <include>**/images/**</include>
                                        <include>assets/**</include>
                                    </includes>
                                </resource>
                            </resources>
                            <!-- The site layout (top bar, generated sidebar, pager, footer) is an Asciidoctor extension,
                                see the header of the script. -->
                            <requires>
                                <require>asciidoctor-diagram</require>
                                <require>${project.basedir}/src/docs/extensions/site_layout.rb</require>
                            </requires>
                            <attributes>
                                <diagram-cachedir>${project.build.directory}/diagram-cache</diagram-cachedir>
                                <source-highlighter>rouge</source-highlighter>
                                <!-- Inline token styles, because the dark code panels do not use the theme's colours. -->
                                <rouge-css>style</rouge-css>
                                <rouge-style>monokai.sublime</rouge-style>
                                <!-- The site stylesheet (assets/theme.css, linked by the layout extension) replaces the default. -->
                                <stylesheet>false</stylesheet>
                                <nofooter>true</nofooter>
                                <toc>right</toc>
                                <toc-title>On this page</toc-title>
                                <site-source-dir>${project.basedir}/src/docs/asciidoc</site-source-dir>
                                <project-version>${project.version}</project-version>
                                <revnumber>${project.version}</revnumber>
                                <revdate>${maven.build.timestamp}</revdate>
                                <revremark>Built with Maven</revremark>
                            </attributes>
                            <logHandler>
                                <outputToConsole>true</outputToConsole>
                                <failIf>
                                    <severity>WARN</severity>
                                </failIf>
                            </logHandler>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <docs.output.directory>${docs.output.directory}</docs.output.directory>
                        <docs.source.directory>${project.basedir}/src/docs/asciidoc</docs.source.directory>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
