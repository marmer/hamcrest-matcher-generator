<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.marmer.testutils</groupId>
        <artifactId>matcher-generator-parent</artifactId>
        <version>5.1.0</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>hamcrest-matcher-generator-annotationprocessor</artifactId>
    <packaging>pom</packaging>
    <name>hamcrest-matcher-generator-annotationprocessor</name>
    <description>Relocation POM. Moved to hamcrest-matcher-generator since 6.0.0.</description>

    <!-- Resolvers that follow the relocation ignore these dependencies. They keep the old coordinates usable inside a
        reactor build, where a relocation is not followed (the 5.x compatibility module relies on it). -->
    <dependencies>
        <dependency>
            <groupId>io.github.marmer.testutils</groupId>
            <artifactId>hamcrest-matcher-generator</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <distributionManagement>
        <relocation>
            <groupId>io.github.marmer.testutils</groupId>
            <artifactId>hamcrest-matcher-generator</artifactId>
            <version>${project.version}</version>
            <message>Since 6.0.0 hamcrest-matcher-generator-annotationprocessor is part of hamcrest-matcher-generator (the Hamcrest backend and its
                runtime library); the configuration annotations come with it.</message>
        </relocation>
    </distributionManagement>
</project>
