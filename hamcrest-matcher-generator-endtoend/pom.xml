<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://maven.apache.org/POM/4.0.0"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.marmer.testutils</groupId>
        <artifactId>matcher-generator-parent</artifactId>
        <version>5.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- Groups the end-to-end modules in one reactor group. They are the parent of each group member, so the group
        shares the settings below; the modules themselves stay in their own directories. -->
    <artifactId>hamcrest-matcher-generator-endtoend</artifactId>
    <version>5.1.0</version>
    <packaging>pom</packaging>
    <name>hamcrest-matcher-generator-endtoend</name>
    <description>Groups the end-to-end modules. Never published.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <modules>
        <module>../hamcrest-matcher-generator-endtoend-plain-java-minimal</module>
        <module>../hamcrest-matcher-generator-endtoend-mixed-kotlin-java</module>
        <module>../hamcrest-matcher-generator-endtoend-plain-kotlin</module>
        <module>../hamcrest-matcher-generator-endtoend-java-records</module>
        <module>../hamcrest-matcher-generator-endtoend-lombok</module>
        <module>../hamcrest-matcher-generator-endtoend-assertj</module>
        <module>../hamcrest-matcher-generator-endtoend-5x-compatibility-runner</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Generated matchers must compile without a single warning (QS-N3). Without showWarnings the plugin
                        passes -nowarn, and -Werror then fails with "An unknown compilation problem occurred". -->
                    <showWarnings>true</showWarnings>
                    <compilerArgs combine.children="append">
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
